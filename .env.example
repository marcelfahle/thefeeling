# Read-only CDA token, published content ("Website (published)" role)
DATOCMS_PUBLISHED_CDA_TOKEN=
# Read-only CDA token with draft access ("Website (drafts)" role). Sent to editor preview sessions.
DATOCMS_DRAFT_CDA_TOKEN=
# Empty = primary environment; e.g. "nextjs-preview" for the sandbox
DATOCMS_ENVIRONMENT=
# https://<project>.admin.datocms.com
DATOCMS_BASE_EDITING_URL=https://the-feeling.admin.datocms.com
# "v1" to request stega Content Link data (needs a DatoCMS plan with Visual Editing). Empty = record-level click-to-edit only.
DATOCMS_CONTENT_LINK=
# CMA token for the "Layout writer" role (update page_portfolio/page_archive only)
DATOCMS_LAYOUT_CMA_TOKEN=
# Shared secret used by the Web Previews plugin and /api/draft-mode/enable
PREVIEW_SECRET=
# Bearer token for /api/invalidate-cache (DatoCMS webhook)
WEBHOOK_SECRET=
# HMAC key for preview-role cookies and share links
PREVIEW_SESSION_SECRET=
# Bold video API key (server-only)
BOLD_API_KEY=
# Canonical origin, e.g. https://thefeeling.de. Setting it turns on indexing (robots, sitemap, canonical URLs).
# Leave empty on preview/staging hosts: they are then noindex and use the Vercel URL.
SITE_URL=
